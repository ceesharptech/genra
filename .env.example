# Public Client Variables (Allowed to carry NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL_AUTH_MODE=magic_link
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# Server-Only Variables (Forbidden from carrying NEXT_PUBLIC_ prefix)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_ENRICHMENT_ENABLED=false

# Build & CI Secrets (Never committed, never exposed to client)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
