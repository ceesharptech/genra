# Public Client Variables (Allowed to carry NEXT_PUBLIC_ prefix - Inlined at Build Time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://genra.dev
NEXT_PUBLIC_EMAIL_AUTH_MODE=magic_link
NEXT_PUBLIC_SUPPORT_EMAIL=support@genra.dev
NEXT_PUBLIC_LEGAL_NAME=Genra Inc.
NEXT_PUBLIC_GOVERNING_LAW=State of Delaware, United States
NEXT_PUBLIC_MIN_AGE=13
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_DEBUG=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DEBUG=false

# Server-Only Variables (Forbidden from carrying NEXT_PUBLIC_ prefix)
CSP_MODE=report-only
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_ENRICHMENT_ENABLED=false
SENTRY_DEBUG=false
SENTRY_TEST_TOKEN=

# Build-Time Secrets for Sentry Releases & Sourcemaps (Server-only Vercel variables)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
